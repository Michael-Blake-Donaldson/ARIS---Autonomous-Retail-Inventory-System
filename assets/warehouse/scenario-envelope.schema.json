{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARGUS Phase 1 scenario envelope example",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "seed"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "scenarioId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
