file(MAKE_DIRECTORY "${ARGUS_TEST_DIR}")
set(work "${ARGUS_TEST_DIR}/missions.db")
set(catalog "${ARGUS_TEST_DIR}/catalog.db")
file(REMOVE "${work}" "${catalog}")

function(mission expected_status)
    execute_process(
        COMMAND "${ARGUS_EXECUTABLE}" "${work}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE error
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE
        TIMEOUT 25
    )
    if(NOT status STREQUAL expected_status)
        message(FATAL_ERROR "Mission command ${ARGN} returned '${status}': ${error}")
    endif()
    set(report "${out}" PARENT_SCOPE)
endfunction()

function(field expected name)
    string(JSON actual GET "${report}" "${name}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected ${name}=${expected}, got ${actual}: ${report}")
    endif()
endfunction()

