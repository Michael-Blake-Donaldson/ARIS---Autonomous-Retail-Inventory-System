foreach(pass RANGE 1 2)
    execute_process(COMMAND "${ARGUS_EXECUTABLE}" --warehouse small-backroom --tick 8 --sensor-steps 36
        OUTPUT_VARIABLE snapshot RESULT_VARIABLE status ERROR_VARIABLE diagnostics TIMEOUT 8)
    if(NOT status STREQUAL "0" OR snapshot MATCHES "truePose|offsetMm|headingDeg|rackId")
        message(FATAL_ERROR "Sensor replay failed or exposed placement truth: ${status}, ${diagnostics}")
    endif()
    if(pass EQUAL 1)
        set(first "${snapshot}")
    elseif(NOT first STREQUAL snapshot)
        message(FATAL_ERROR "Sensor replay produced different observations")
    endif()
endforeach()

string(JSON backlog GET "${snapshot}" sensors queuedBeforeDrain)
string(JSON length LENGTH "${snapshot}" sensors observations)
if(NOT backlog EQUAL 24 OR NOT length EQUAL 24)
    message(FATAL_ERROR "Sensor replay did not respect queue capacity: ${backlog}, ${length}")
endif()

set(expected-wheel-encoder 36)
set(expected-lidar 18)
set(expected-rfid 18)
foreach(stream IN ITEMS wheel-encoder lidar rfid)
    string(JSON produced GET "${snapshot}" sensors throughput "${stream}" produced)
    string(JSON consumed GET "${snapshot}" sensors throughput "${stream}" consumed)
    string(JSON dropped GET "${snapshot}" sensors throughput "${stream}" dropped)
    math(EXPR accounted "${consumed} + ${dropped}")
    if(NOT produced EQUAL expected-${stream} OR NOT produced EQUAL accounted OR dropped LESS 1)
        message(FATAL_ERROR "Unexpected sensor counters for ${stream}: ${produced}, ${consumed}, ${dropped}")
    endif()
endforeach()

math(EXPR last "${length} - 1")
set(previous 0)
foreach(i RANGE 0 ${last})
    string(JSON observed GET "${snapshot}" sensors observations ${i})
    string(JSON provenance GET "${observed}" provenance)
    string(JSON sample_tick GET "${observed}" sampleTick)
    string(JSON world_tick GET "${observed}" worldTick)
    string(JSON timestamp GET "${observed}" timestampMs)
    string(JSON estimate_x GET "${observed}" estimatedPose xM)
    math(EXPR expected_stamp "${sample_tick} * 50")
    math(EXPR expected_world "${sample_tick} + 8")
    if(NOT provenance STREQUAL "simulated" OR sample_tick LESS previous OR NOT timestamp EQUAL expected_stamp
       OR NOT world_tick EQUAL expected_world OR estimate_x LESS 5.5)
        message(FATAL_ERROR "Invalid sensor metadata at index ${i}: ${observed}")
    endif()
    set(previous "${sample_tick}")
endforeach()

execute_process(COMMAND "${ARGUS_EXECUTABLE}" --warehouse small-backroom --sensor-steps 2001
    OUTPUT_VARIABLE output RESULT_VARIABLE status ERROR_VARIABLE diagnostics TIMEOUT 5)
if(NOT status STREQUAL "2" OR NOT output STREQUAL "" OR NOT diagnostics MATCHES "invalid_sensor_steps")
    message(FATAL_ERROR "Oversized sensor probe was not rejected: ${status}, ${diagnostics}")
endif()
