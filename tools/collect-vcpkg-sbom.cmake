cmake_minimum_required(VERSION 3.25)

if(NOT IS_DIRECTORY "${ARGUS_BUILD_DIR}" OR ARGUS_SBOM_DIR STREQUAL "" OR
   NOT DEFINED ARGUS_SBOM_DIR OR NOT ARGUS_TRIPLET MATCHES "^x64-(windows|linux)$")
    message(FATAL_ERROR "Set ARGUS_BUILD_DIR, ARGUS_SBOM_DIR, and ARGUS_TRIPLET")
endif()
set(installed "${ARGUS_BUILD_DIR}/vcpkg_installed/${ARGUS_TRIPLET}/share")
file(GLOB documents LIST_DIRECTORIES false "${installed}/*/vcpkg.spdx.json")
if(NOT documents)
    message(FATAL_ERROR "No vcpkg SPDX documents in the selected build")
endif()
file(MAKE_DIRECTORY "${ARGUS_SBOM_DIR}")
set(checksums "")
foreach(document IN LISTS documents)
    get_filename_component(parent "${document}" DIRECTORY)
    get_filename_component(port "${parent}" NAME)
    file(READ "${document}" data)
    string(JSON version GET "${data}" spdxVersion)
    if(NOT version STREQUAL "SPDX-2.3")
        message(FATAL_ERROR "Unexpected SPDX version in ${port}")
    endif()
    configure_file("${document}" "${ARGUS_SBOM_DIR}/${port}.spdx.json" COPYONLY)
    file(SHA256 "${document}" digest)
    string(APPEND checksums "${digest}  ${port}.spdx.json\n")
endforeach()
file(WRITE "${ARGUS_SBOM_DIR}/SHA256SUMS" "${checksums}")
list(LENGTH documents count)
message(STATUS "Collected ${count} SPDX documents for ${ARGUS_TRIPLET}")
